{
  "appId": "com.halfgridgames.sandjars",
  "appName": "Sand Jars",
  "webDir": "www",
  "backgroundColor": "#3a2450",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#3a2450"
  },
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  },
  "ios": {
    "includePlugins": [
      "@capacitor-community/admob",
      "@capacitor-community/in-app-review",
      "cordova-plugin-purchase"
    ]
  }
}
